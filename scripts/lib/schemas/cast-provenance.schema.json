{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cast-provenance.schema.json",
  "title": "Cast Provenance",
  "description": "Forensic record of a cast: what got produced, from which Mold revision, by which method, and the source and destination hash of every reference it resolved.",
  "type": "object",
  "additionalProperties": false,
  "required": ["provenance_schema_version", "cast_target", "mold", "refs"],
  "properties": {
    "provenance_schema_version": { "type": "integer", "const": 4 },
    "cast_target": { "type": "string" },
    "mold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "revision": { "type": "integer" },
        "content_hash": { "type": "string" },
        "commit": { "type": ["string", "null"] }
      }
    },
    "cast_method": { "type": "string" },
    "cast_agent": { "type": "string" },
    "cast_at": { "type": "string", "format": "date-time" },
    "cast_date": { "type": "string" },
    "cast_revision": { "type": "integer" },
    "cast_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rev", "date", "note"],
        "properties": {
          "rev": { "type": "integer" },
          "date": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "refs": {
      "type": "array",
      "description": "One entry per resolved reference, sorted by (kind, src) for stability.",
      "items": { "$ref": "#/definitions/refEntry" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["produces", "consumes"],
      "description": "Pipeline artifact handoff contract copied from the Mold's frontmatter so harnesses can wire prior-step paths to a stable id.",
      "properties": {
        "produces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "default_filename", "description"],
            "properties": {
              "id": { "type": "string" },
              "kind": { "type": "string" },
              "default_filename": { "type": "string" },
              "schema": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "consumes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description"],
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "inherited_schema": { "type": "string" },
              "producers": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "validation_results": {
      "type": "array",
      "description": "Process evidence from artifact validator CLI runs. Exit code is authoritative; stdout/stderr are captured as opaque diagnostics.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "path",
          "validator_bin",
          "status",
          "exit_code",
          "stdout",
          "stderr",
          "stdout_hash",
          "stderr_hash"
        ],
        "properties": {
          "artifact_id": { "type": "string" },
          "path": { "type": "string" },
          "validator_bin": { "type": "string" },
          "status": { "enum": ["passed", "failed", "error"] },
          "exit_code": { "type": ["integer", "null"] },
          "artifact_hash": { "type": "string" },
          "stdout": { "type": "string" },
          "stderr": { "type": "string" },
          "stdout_hash": { "type": "string" },
          "stderr_hash": { "type": "string" },
          "error": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "refEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mode", "src", "dst", "source", "used_at", "load"],
      "properties": {
        "kind": { "enum": ["schema", "research", "pattern", "cli-tool", "cli-command", "prompt"] },
        "mode": { "enum": ["verbatim", "sidecar"] },
        "ref": {
          "type": "string",
          "description": "The original Mold ref (wiki-link or path)."
        },
        "src": { "type": "string", "description": "Resolved repo-relative source path." },
        "dst": { "type": "string", "description": "Bundle-relative destination path." },
        "used_at": { "enum": ["cast-time", "runtime", "both"] },
        "load": { "enum": ["upfront", "on-demand"] },
        "evidence": { "enum": ["hypothesis", "corpus-observed", "cast-validated"] },
        "purpose": { "type": "string" },
        "trigger": { "type": "string" },
        "verification": { "type": "string" },
        "src_hash": {
          "type": ["string", "null"],
          "description": "sha256 of source file at cast time."
        },
        "dst_hash": {
          "type": ["string", "null"],
          "description": "sha256 of destination file at cast time. For mode=verbatim it equals src_hash, which is the proof that nothing was paraphrased between source and artifact."
        },
        "source": {
          "enum": ["deterministic"],
          "description": "How this ref's dst content was produced. Casting has no LLM phase, so the only value is `deterministic` — recorded rather than implied, because it is the claim the provenance makes."
        },
        "companion_of": {
          "type": "string",
          "description": "Bundle-relative dst of the parent note when this ref is a sibling companion file copied alongside it."
        },
        "license": {
          "type": "string",
          "description": "License id of the upstream work this ref draws on, from the source note's frontmatter. Its presence alone does not mean upstream expression is redistributed; see derived."
        },
        "derived": {
          "type": "string",
          "description": "How an authored note relates to the licensed work it cites. Absent for raw vendored payloads, which are pass-through by definition."
        },
        "license_file": {
          "type": "string",
          "description": "Repo-relative LICENSES/ path associated with this ref's licensed lineage."
        },
        "license_file_hash": {
          "type": "string",
          "description": "sha256 of the license_file at cast time, binding the recorded licensed lineage to exact licence text."
        }
      }
    }
  }
}
