---
import { getAllNotes, noteTitle } from '../../lib/notes';
import Base from '../../layouts/Base.astro';
import { DESIGN_DOC_GROUPS, designDocsByCategory, designDocHref } from '../../lib/design-docs';
import { base } from '../../lib/site-base';

const allNotes = await getAllNotes();
const designDocGroups = await Promise.all(
  DESIGN_DOC_GROUPS.map(async group => ({
    ...group,
    docs: await designDocsByCategory(group.category),
  })),
);

// Group by top-level directory.
const byDir = new Map<string, typeof allNotes>();
for (const n of allNotes) {
  const dir = n.id.split('/')[0];
  const list = byDir.get(dir) ?? [];
  list.push(n);
  byDir.set(dir, list);
}
const dirs = [...byDir.entries()]
  .map(([dir, notes]) => ({
    dir,
    notes: notes.sort((a, b) => a.id.localeCompare(b.id)),
  }))
  .sort((a, b) => a.dir.localeCompare(b.dir));

---
<Base title="Index">
  <section class="page-hero bg-grain" aria-labelledby="index-heading">
    <span class="eyebrow mb-3">Full Index</span>
    <div class="page-hero-grid">
      <div>
        <h1 id="index-heading" class="page-title text-balance">Every note in the Foundry.</h1>
        <p class="page-lede text-pretty">
          A directory-grouped map of content notes, reference material, and generated navigation surfaces.
        </p>
      </div>
      <dl class="page-stats" aria-label="Index stats">
        <div>
          <dt>Notes</dt>
          <dd>{allNotes.length}</dd>
        </div>
        <div>
          <dt>Dirs</dt>
          <dd>{dirs.length}</dd>
        </div>
      </dl>
    </div>
  </section>

  {dirs.map(d => (
    <section class="mb-8">
      <h2 class="text-xl font-bold border-b-2 border-(--color-accent)/20 pb-2 mb-3">
        <code class="font-mono">{d.dir}/</code>
        <span class="ml-2 text-sm font-normal text-(--color-text-muted)">({d.notes.length})</span>
      </h2>
      <ul class="list-none p-0 space-y-1">
        {d.notes.map(n => (
          <li class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3">
            <a href={`${base}/${n.id}/`} class="text-(--color-link) hover:underline font-medium">{noteTitle(n)}</a>
            <span class="text-xs px-1.5 py-0.5 rounded bg-(--color-surface-raised) text-(--color-text-secondary) w-fit">{n.data.type}</span>
            <span class="text-sm text-(--color-text-muted) italic">{n.data.summary}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="mb-8">
    <h2 class="text-xl font-bold border-b-2 border-(--color-accent)/20 pb-2 mb-3">
      <code class="font-mono">docs/</code>
      <span class="ml-2 text-sm font-normal text-(--color-text-muted)">
        ({designDocGroups.reduce((sum, group) => sum + group.docs.length, 0)})
      </span>
    </h2>
    {designDocGroups.map(group => (
      <div class="design-index-group">
        <h3>{group.title}</h3>
        <ul class="list-none p-0 space-y-1">
          {group.docs.map(doc => (
            <li class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3">
              <a href={designDocHref(doc, base)} class="text-(--color-link) hover:underline font-medium">{doc.data.title}</a>
              <span class="text-xs px-1.5 py-0.5 rounded bg-(--color-surface-raised) text-(--color-text-secondary) w-fit">
                {doc.data.record_kind === 'infrastructure' ? 'project infrastructure' : 'design record'}
              </span>
              <span class="text-sm text-(--color-text-muted) italic">{doc.data.summary}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</Base>

<style>
  .design-index-group + .design-index-group {
    margin-top: 1rem;
  }
  .design-index-group h3 {
    margin: 0 0 0.45rem;
    color: var(--color-text-primary);
    font-size: 0.95rem;
  }
</style>
