---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RunPipelines from '../../components/RunPipelines.astro';
import { PIPELINE_JOURNEY_LABELS, pipelineJourney } from '../../lib/pipeline-journeys';
import { base } from '../../lib/site-base';

const pipelines = (await getCollection('pipelines'))
  .filter(n => n.data.status !== 'archived')
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const totalPhases = pipelines.reduce((sum, p) => sum + phaseCount(p.data.phases), 0);

function phaseCount(phases: unknown): number {
  return Array.isArray(phases) ? phases.length : 0;
}
---
<Base title="Pipelines">
  <section class="page-hero bg-grain" aria-labelledby="pipelines-heading">
    <span class="eyebrow mb-3">Harness Pipelines</span>
    <div class="page-hero-grid">
      <div>
        <h1 id="pipelines-heading" class="page-title text-balance">Build routes, from source to outcome.</h1>
        <p class="page-lede text-pretty">
          Build directly, plan through a reviewable Workflow Brief, or work on an existing Galaxy workflow.
          Each pipeline composes Molds into one runnable harness.
        </p>
        <p class="mt-3 text-sm">
          <a href={`${base}/usage/#run-pipelines`} class="text-(--color-link) hover:underline">
            Run a pipeline →
          </a>
          <span class="text-(--color-text-muted)"> — how to run one end-to-end today.</span>
        </p>
      </div>
      <dl class="page-stats" aria-label="Pipeline stats">
        <div>
          <dt>Total</dt>
          <dd>{pipelines.length}</dd>
        </div>
        <div>
          <dt>Phases</dt>
          <dd>{totalPhases}</dd>
        </div>
      </dl>
    </div>
  </section>

  <p class="table-hint">Scroll horizontally to compare every column.</p>
  <div class="pipeline-table-wrap" role="region" aria-label="Pipeline catalog" tabindex="0">
    <table class="data-table">
      <thead><tr><th>Pipeline</th><th>Journey</th><th>Summary</th><th>Phases</th><th>Status</th></tr></thead>
      <tbody>
        {pipelines.map(p => {
          const d = p.data;
          return (
            <tr>
              <td><a href={`${base}/${p.id}/`}>{d.title}</a></td>
              <td class="text-sm">{PIPELINE_JOURNEY_LABELS[pipelineJourney(d.tags)]}</td>
              <td class="text-sm text-(--color-text-muted)">{d.summary}</td>
              <td>{phaseCount(d.phases)}</td>
              <td><span class={`badge badge-${d.status}`}>{d.status}</span></td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <section class="mt-12">
    <RunPipelines variant="text" />
  </section>
</Base>

<style>
  .pipeline-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.5rem;
  }
  .pipeline-table-wrap:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .pipeline-table-wrap .data-table {
    min-width: 54rem;
    margin: 0;
  }
  .table-hint {
    display: none;
    margin: 0 0 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }
  @media (max-width: 700px) {
    .table-hint { display: block; }
  }
</style>
