---
import { getAllNotes } from '../../lib/notes';
import Base from '../../layouts/Base.astro';
import { getLicenses } from '../../lib/licenses';
import { redistributesUnder } from '@galaxy-foundry/license-policy';
import type { LicenseFileUse } from '@galaxy-foundry/site-kit';
import LicenseFileBody from '@galaxy-foundry/site-kit/LicenseFileBody.astro';
import { licensePolicy } from '../../lib/registries';
import { base } from '../../lib/site-base';

export async function getStaticPaths() {
  return getLicenses().map(licenseFile => ({
    params: { id: licenseFile.id },
    props: { licenseFile },
  }));
}

const { licenseFile } = Astro.props;

// Which notes redistribute under this copy is the per-instance half: our corpus is one flat
// collection addressed as `/{id}/`, so this walk and these hrefs stay here. The membership test
// does not — `redistributesUnder` compares a note's `license_file` path against a file id, which
// this page used to spell as an equality between two things both called `licenseId`.
const entries = await getAllNotes();
const uses: LicenseFileUse[] = entries
  .filter(e => 'license_file' in e.data && redistributesUnder(e.data.license_file, licenseFile.id))
  .map(e => ({
    href: `${base}/${e.id}/`,
    label: e.id,
    licenseId: 'license' in e.data ? e.data.license : undefined,
  }))
  .sort((a, b) => a.label.localeCompare(b.label));
---
<Base title={`license: ${licenseFile.id}`}>
  <header class="mb-4">
    <p class="text-xs font-mono uppercase tracking-widest text-(--color-text-muted) mb-1">license</p>
    <h1 class="text-2xl font-mono font-semibold m-0">{licenseFile.filename}</h1>
  </header>

  <LicenseFileBody licenseFile={licenseFile} policy={licensePolicy} uses={uses} />
</Base>
