---
import { getCollection } from 'astro:content';
import { companionOf, readCompanion } from '../../lib/note-directory';
import Base from '../../layouts/Base.astro';
import { base } from '../../lib/site-base';

const EVAL = companionOf('mold', 'eval.md');
const molds = (await getCollection('molds')).filter(n => n.data.status !== 'archived');
const evalCount = molds.filter(m => hasEval(m.id)).length;

// Group by axis.
const AXES = ['source-specific', 'target-specific', 'tool-specific', 'generic'] as const;
const byAxis = new Map<string, typeof molds>();
for (const m of molds) {
  const ax = m.data.axis;
  const list = byAxis.get(ax) ?? [];
  list.push(m);
  byAxis.set(ax, list);
}
for (const [, list] of byAxis) list.sort((a, b) => a.data.name.localeCompare(b.data.name));

function hasEval(id: string): boolean {
  return readCompanion(id, EVAL) !== undefined;
}

function healthFor(m: typeof molds[number]): 'ok' | 'warn' | 'error' {
  const d = m.data;
  if (d.axis === 'source-specific' && !d.source) return 'error';
  if (d.axis === 'target-specific' && !d.target) return 'error';
  if (d.axis === 'tool-specific' && !d.tool) return 'error';
  if (!hasEval(m.id)) return 'warn';
  // The same two checks MoldHealth runs on a mold's own page. Both read the reference fields from
  // the kind now; under `any` they were two private copies of a question with no wrong answer.
  const refs = d.references ?? [];
  if (refs.some(ref => ref.evidence === 'hypothesis' && !ref.verification)) return 'error';
  if (refs.some(ref => ref.load === 'on-demand' && !ref.trigger)) return 'warn';
  return 'ok';
}
---
<Base title="Molds">
  <section class="page-hero bg-grain" aria-labelledby="molds-heading">
    <span class="eyebrow mb-3">Mold Inventory</span>
    <div class="page-hero-grid">
      <div>
        <h1 id="molds-heading" class="page-title text-balance">Source artifacts for casting.</h1>
        <p class="page-lede text-pretty">
          Molds are atomic action templates grouped by axis, then cast into target-specific skills and harness steps.
        </p>
      </div>
      <dl class="page-stats" aria-label="Mold inventory stats">
        <div>
          <dt>Total</dt>
          <dd>{molds.length}</dd>
        </div>
        <div>
          <dt>Axes</dt>
          <dd>{[...byAxis.values()].filter(list => list.length > 0).length}</dd>
        </div>
        <div>
          <dt>Eval Plans</dt>
          <dd>{evalCount}/{molds.length}</dd>
        </div>
      </dl>
    </div>
  </section>

  {AXES.map(axis => {
    const list = byAxis.get(axis) ?? [];
    if (list.length === 0) return null;
    return (
      <section class="mold-group" aria-labelledby={`molds-${axis}`}>
        <div class="section-rule">
          <h2 id={`molds-${axis}`}>
            <span class="axis-chip font-mono">{axis}</span>
          </h2>
          <span class="section-tail">/ {list.length} {list.length === 1 ? 'mold' : 'molds'}</span>
        </div>
        <div class="card-grid">
          {list.map(m => {
            const d = m.data;
            const spec = d.source ?? d.target ?? d.tool ?? null;
            const health = healthFor(m);
            const evalPresent = hasEval(m.id);
            const subjectTags = (d.tags as string[] ?? []).filter(t => t !== 'mold');
            return (
              <article class="card tinted-shadow tinted-shadow-hover">
                <div class="card-top">
                  <span class={`badge badge-${d.status}`}>{d.status}</span>
                  {spec && <span class="card-top-chip">{spec}</span>}
                </div>
                <h3 class="card-title">
                  <a href={`${base}/${m.id}/`} class="font-mono">{d.name}</a>
                </h3>
                <p class="card-summary">{d.summary}</p>
                {subjectTags.length > 0 && (
                  <div class="card-tags" aria-label="Tags">
                    {subjectTags.slice(0, 4).map(tag => <span class="tag">{tag}</span>)}
                  </div>
                )}
                <div class="card-meta" aria-label="Mold health">
                  <span><span class="card-meta-label">health</span><span class={`health health-${health}`}>{health}</span></span>
                  <span><span class="card-meta-label">eval</span>{evalPresent ? '✓' : '—'}</span>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    );
  })}
</Base>

<style>
  .mold-group {
    margin-bottom: 2rem;
  }
  .axis-chip {
    display: inline-block;
    padding: 0.18rem 0.55rem;
    border-radius: 0.3rem;
    background: var(--color-brand);
    color: white;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    vertical-align: middle;
  }
  .health {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.05rem 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    color: white;
  }
  .health-ok { background: #18794e; }
  .health-warn { background: #b7791f; }
  .health-error { background: #c53030; }
</style>
