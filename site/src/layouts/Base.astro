---
// `global.css` imports FIRST, ahead of the component, because import order is what decides where
// Astro puts the <link> in <head>. Moving it below the shell import pushed the stylesheet after
// every page's scoped <style> on the 19 pages that have one, and dropped Tailwind's `/*!` license
// banner from the emitted CSS. Neither showed up in a diff of the markup.
//
// Watch the words in this comment. Tailwind scans source TEXT, comments included, so a sentence
// here that happens to name a utility ships a rule for it. An adjective in an earlier draft of
// this very comment did that: one stray word, one rule, for a class no page carries. Which is why
// the paragraph above says "showed up" rather than the word it wants to say.
import '../styles/global.css';
import SiteShell from '@galaxy-foundry/site-kit/SiteShell.astro';

import { base } from '../lib/site-base';
import { SITE_IDENTITY } from '../lib/site-identity';

// The composition point for @galaxy-foundry/site-kit, and the only file in this repo that knows
// the shell is a package. Every page still imports this layout and passes the same two props.
//
// The stylesheet import stays here because it is this instance's: the kit brings no CSS, only
// Tailwind utilities and the names of tokens `global.css` defines. That file also has to point
// Tailwind at the kit's source — without the `@source` line there, every utility the kit writes is
// missing from the emitted stylesheet and the build stays green.
//
// `BASE_URL` and the pathname are read by this INSTANCE, never by the kit, so the kit reads no
// environment. The base comes from `lib/site-base` — the same import every page here builds its
// hrefs from — so the chrome and the corpus cannot resolve it differently. Not tidiness: under
// vitest `import.meta.env.BASE_URL` is mirrored into the process and comes back as `/`, which is
// how this repo's suite once spent weeks asserting against a site built at the wrong base.
interface Props {
  title: string;
  description?: string;
  /**
   * Whether this page's main content goes in the search index. Defaults to yes.
   *
   * Pagefind's rule is all-or-nothing and runs backwards from what the attribute looks like: mark
   * no page and every page is indexed from its `<body>`, mark ONE and every unmarked page leaves
   * the index entirely. So the default has to be yes — opt-in would leave each new route one
   * forgotten prop away from being unfindable, with nothing on the page to see. Asserted against
   * the built index in `tests/built-shell.test.ts`.
   *
   * Declared here and passed on UNSET, so the kit keeps the default. Restating `= true` on this
   * side would put one rule in two places, and the day they disagree the wrong one is the one a
   * reader of this file would trust.
   */
  searchable?: boolean;
}
const { title, description, searchable } = Astro.props;
---
<SiteShell
  title={title}
  description={description}
  base={base}
  pathname={Astro.url.pathname}
  identity={SITE_IDENTITY}
  searchable={searchable}
>
  <slot />
</SiteShell>
