---
import { type NoteEntry, type NoteField } from '../lib/notes';
import { resolveLicenseRow } from '@galaxy-foundry/license-policy';
import { licenseFileHref } from '@galaxy-foundry/site-kit';
import LicenseBadge from '@galaxy-foundry/site-kit/LicenseBadge.astro';
import { licensePolicy } from '../lib/registries';
import { base } from '../lib/site-base';

interface Props {
  entry: NoteEntry;
}

const { entry } = Astro.props;
const data = entry.data;

// The union, not one kind: a license travels with redistributed material, and which kinds carry
// redistributed material is not this component's to decide.
//
// The keys go through `satisfies NoteField` because `in` does not check them — `'nope' in data`
// compiles — so a field renamed in every schema that declares it would leave this panel silently
// empty on notes that do redistribute. The assertion is that some kind still answers the question.
const LICENSE = 'license' satisfies NoteField;
const LICENSE_FILE = 'license_file' satisfies NoteField;
const UPSTREAM = 'upstream' satisfies NoteField;

const license = LICENSE in data ? data.license : undefined;
const licenseFile = LICENSE_FILE in data ? data.license_file : undefined;
const upstream = UPSTREAM in data ? data.upstream : undefined;

// Only rendered for notes that carry a license (third-party redistribution).
//
// The row is still resolved here for `obligations`, which is the box's own line rather than the
// badge's: what the licence PERMITS travels with the licence, what this note owes for using it is
// ours. See the badge's header comment for where that line is drawn.
const row = license ? resolveLicenseRow(licensePolicy, license) : undefined;
const licenseHref = licenseFile ? licenseFileHref(base, licenseFile) : undefined;
---
{license && row && (
  <aside class="license-box not-prose">
    <div class="license-tags">
      <LicenseBadge license={license} policy={licensePolicy} />
    </div>
    <p class="license-obligations">{row.obligations}</p>
    <p class="license-links">
      {upstream && (
        <a href={upstream} class="license-link">Original source ↗</a>
      )}
      {upstream && licenseHref && <span aria-hidden="true"> · </span>}
      {licenseHref ? (
        <a href={licenseHref} class="license-link">License terms</a>
      ) : (
        <span class="license-muted">No text redistributed — cited only.</span>
      )}
    </p>
  </aside>
)}

<style>
  .license-box {
    margin: 0 0 1.75rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.6rem;
    background: var(--color-surface-raised);
    font-size: 0.85rem;
  }
  /* The chips' own layout is the badge's; this is only the gap to the obligations line below. */
  .license-tags {
    margin-bottom: 0.5rem;
  }
  .license-obligations {
    margin: 0 0 0.5rem;
    color: var(--color-text-secondary);
  }
  .license-links {
    margin: 0;
    color: var(--color-text-muted);
  }
  .license-link {
    color: var(--color-link);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-link) 30%, transparent);
  }
  .license-link:hover {
    color: var(--color-link-hover);
    border-color: var(--color-accent);
  }
  .license-muted {
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
