---
import { type NoteEntry } from '../lib/notes';
import type { CompanionRequirement, NormalizedCompanion } from '@galaxy-foundry/kind-schema';
import { checkNoteDirectory, companionOf, readCompanion } from '../lib/note-directory';
import HealthPanel from './HealthPanel.astro';
import { resolveWikiLinkId, WIKI_LINK_RE, type WikiLinkTarget } from '../lib/wiki-links';
import { base } from '../lib/site-base';

interface Props {
  entry: NoteEntry;
  linkMap: Map<string, WikiLinkTarget>;
  entryById: Map<string, NoteEntry>;
}

interface HealthItem {
  label: string;
  state: 'ok' | 'warn' | 'error';
  detail: string;
  help?: string;
  href?: string;
  hrefLabel?: string;
}

const { entry, linkMap, entryById } = Astro.props;
const data = entry.data as any;

// The two files this panel reports on, taken from the kind rather than described here. The
// NAME stays, because the checks below read these files' contents and no declaration can say
// what a Property section is — but the purpose, the requirement level, and whether the mold
// kind still declares them at all are the kind's to answer.
const EVAL = companionOf('mold', 'eval.md');
const SCENARIOS = companionOf('mold', 'scenarios.md');

const evalBody = readCompanion(entry.id, EVAL);
const scenariosBody = readCompanion(entry.id, SCENARIOS);
const layout = checkNoteDirectory(entry.id, 'mold');

/** How loudly an absent companion reads, from what the kind asked for. */
const MISSING_STATE: Record<CompanionRequirement, 'ok' | 'warn' | 'error'> = {
  required: 'error',
  recommended: 'warn',
  optional: 'ok',
};

const hrefFor = (companion: NormalizedCompanion): string =>
  `${base}/raw/${entry.id}/${companion.name}`;

function hasAxisSpecifier(): boolean {
  if (data.axis === 'source-specific') return Boolean(data.source);
  if (data.axis === 'target-specific') return Boolean(data.target);
  if (data.axis === 'tool-specific') return Boolean(data.tool);
  return true;
}

function referenceFindings(): HealthItem[] {
  const refs = Array.isArray(data.references) ? data.references : [];
  const items: HealthItem[] = [];
  const unresolved = refs.filter((ref: any) => {
    if (typeof ref?.ref !== 'string' || !WIKI_LINK_RE.test(ref.ref)) return false;
    return !resolveWikiLinkId(ref.ref, linkMap);
  });
  const missingTriggers = refs.filter((ref: any) => ref?.load === 'on-demand' && !ref.trigger);
  const missingVerification = refs.filter((ref: any) => ref?.evidence === 'hypothesis' && !ref.verification);
  const wrongCliRefs = refs.filter((ref: any) => {
    if (ref?.kind !== 'cli-command' || typeof ref.ref !== 'string') return false;
    const id = resolveWikiLinkId(ref.ref, linkMap);
    if (!id) return false;
    return entryById.get(id)?.data.type !== 'cli-command';
  });

  items.push({
    label: 'Typed refs',
    state: unresolved.length === 0 && wrongCliRefs.length === 0 ? 'ok' : 'error',
    detail: refs.length === 0
      ? 'No typed references yet.'
      : `${refs.length} typed reference${refs.length === 1 ? '' : 's'}; ${unresolved.length + wrongCliRefs.length} resolver issue${unresolved.length + wrongCliRefs.length === 1 ? '' : 's'}.`,
  });
  items.push({
    label: 'On-demand triggers',
    state: missingTriggers.length === 0 ? 'ok' : 'warn',
    detail: missingTriggers.length === 0 ? 'All on-demand references describe triggers.' : `${missingTriggers.length} on-demand reference${missingTriggers.length === 1 ? '' : 's'} missing trigger.`,
  });
  items.push({
    label: 'Evidence checks',
    state: missingVerification.length === 0 ? 'ok' : 'error',
    detail: missingVerification.length === 0 ? 'Hypothesis references include verification.' : `${missingVerification.length} hypothesis reference${missingVerification.length === 1 ? '' : 's'} missing verification.`,
  });
  return items;
}

/** An absent companion, reported at the volume its requirement level asks for. */
function missing(companion: NormalizedCompanion, label: string): HealthItem {
  return {
    label,
    help: companion.purpose,
    state: MISSING_STATE[companion.requirement],
    detail: `${companion.name} not written yet.`,
  };
}

function evalDetail(): HealthItem {
  if (evalBody === undefined) return missing(EVAL, 'Eval plan');
  const item = { label: 'Eval plan', help: EVAL.purpose, href: hrefFor(EVAL), hrefLabel: EVAL.name };
  const hasProperty = /^##\s+Property:/m.test(evalBody);
  const hasCase = /^##\s+Case:/m.test(evalBody);
  const hasCheck = /\b(deterministic|llm-judged)\b/.test(evalBody);
  if (hasCase) {
    return { ...item, state: 'warn', detail: `${EVAL.name} has a Case section — concrete cases belong in ${SCENARIOS.name}.` };
  }
  if (hasProperty && hasCheck) return { ...item, state: 'ok', detail: `${EVAL.name} declares properties and check type.` };
  return { ...item, state: 'warn', detail: `${EVAL.name} should declare a Property section and a deterministic or llm-judged check.` };
}

function scenariosDetail(): HealthItem {
  if (scenariosBody === undefined) return missing(SCENARIOS, 'Scenarios');
  const item = { label: 'Scenarios', help: SCENARIOS.purpose, href: hrefFor(SCENARIOS), hrefLabel: SCENARIOS.name };
  const hasCase = /^##\s+Case:/m.test(scenariosBody);
  const hasFixture = /\bfixture\b/i.test(scenariosBody);
  if (hasCase && hasFixture) return { ...item, state: 'ok', detail: `${SCENARIOS.name} declares cases bound to fixtures.` };
  if (hasCase) return { ...item, state: 'warn', detail: `${SCENARIOS.name} cases should bind a fixture.` };
  return { ...item, state: 'warn', detail: `${SCENARIOS.name} should declare at least one Case section.` };
}

// What the kind says about the directory, not a rule restated here. `unknown` is a file the mold
// kind does not declare — the misnamed `scenario.md` case — and the validator errors on the same
// set, so this panel and the gate cannot disagree about which files belong.
//
// A declared companion DIRECTORY is checked as a whole and its contents are its own business:
// `refinements/` entries carry frontmatter by declaration, and the recursive frontmatter scan
// this replaced counted every one of them as a layout error.
function layoutDetail(): HealthItem {
  const labelled = { label: 'Source layout' } as const;
  if (layout.unknown.length === 0) {
    return { ...labelled, state: 'ok', detail: 'Every file beside index.md is one the mold kind declares.' };
  }
  const names = layout.unknown.map((e) => e.name).join(', ');
  return { ...labelled, state: 'error', detail: `Undeclared beside the note: ${names}.` };
}

const items: HealthItem[] = [
  layoutDetail(),
  {
    label: 'Axis fields',
    state: hasAxisSpecifier() ? 'ok' : 'error',
    detail: hasAxisSpecifier() ? `${data.axis} fields are coherent.` : `${data.axis} Mold is missing its required specifier.`,
  },
  evalDetail(),
  scenariosDetail(),
  ...referenceFindings(),
];

---
<HealthPanel title="Mold health" items={items} maxColumns={3} />
