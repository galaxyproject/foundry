---
import { type NoteOf } from '../lib/notes';

interface Props {
  entry: NoteOf<'research'>;
}

const { entry } = Astro.props;
const data = entry.data;
---
{data.component && (
  <div class="mb-6 flex flex-wrap gap-2 items-center">
    <span class="text-xs px-2 py-1 rounded border border-(--color-border) font-mono">{data.component}</span>
  </div>
)}
